# Self-contained environment for uav-vision-scene.
# This folder can be copied/moved anywhere; run ./up.sh (or docker compose up -d)
# after updating HOST_IP below if the host machine changes.

HOST_IP=localhost

# DL Streamer Pipeline Server image
DLSTREAMER_PIPELINE_SERVER_IMAGE=intel/dlstreamer-pipeline-server:2026.2.0-ubuntu24

# Maximum allowed size for client request body (e.g. Scenescape GLB 3D base map file uploads)
NGINX_CLIENT_MAX_BODY_SIZE=132m

# SceneScape web admin ("admin") password - generated by src/secrets/generate_secrets.sh,
# kept in sync with src/secrets/supass. Leave blank; install.sh/up.sh populates this at setup time.
SUPASS=

# Host UID/GID used by the broker container; set automatically by up.sh
UID=
GID=
