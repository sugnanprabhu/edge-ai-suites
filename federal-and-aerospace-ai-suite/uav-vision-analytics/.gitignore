# Environment — generated by 'make init', never commit secrets
.env

# Generated self-signed TLS certificate for nginx (created by 'make _check_certs')
configs/nginx/ssl/

# Generated by 'make model' — Python venv and downloaded/exported model artifacts
resources/venv/
resources/models/

# Generated by 'make vlm-model' — downloaded/converted VLM captioning model artifacts
resources/ov_models/

# Cached download_models.sh, fetched on demand by 'make vlm-model' from the
# canonical copy in metro-ai-suite/live-video-analysis/live-video-captioning —
# not vendored, so it's not committed here.
.cache/

# Tracked instance IDs written by scripts/uav_pipeline_control.sh (start/stop
# pipelines manually without arming the drone via MAVLink).
.uav_pipeline_*_instance_id
