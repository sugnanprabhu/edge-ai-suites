# This file is used to set environment variables for the uav-vision-analytics application.

# HOST_IP — auto-detected by 'make init' (LAN IP so QGroundControl/VLC/ffplay on
# other devices can reach the RTSP stream). It also binds nginx's published
# ports (80, 443, 8555): "${HOST_IP:-127.0.0.1}:PORT:PORT" in the compose files.
# Set HOST_IP=127.0.0.1 for loopback-only access (breaks remote QGroundControl/ffplay
# viewing) if the host is not on a trusted, isolated network.
HOST_IP=

# DL Streamer Pipeline Server
DLSTREAMER_PIPELINE_SERVER_IMAGE=intel/dlstreamer-pipeline-server:2026.2.0-ubuntu24

# GPU Device Paths
# Leave empty to use defaults; otherwise set to your GPU device paths.
# Examples: /dev/dri/card1, /dev/dri/renderD129, etc.
GPU_DEVICE=
GPU_RENDER_DEVICE=

# NPU Device Path
# Leave empty to use /dev/null (NPU pipelines disabled) or set to your NPU device.
# Example: /dev/accel/accel0
NPU_DEVICE=

# USB camera device for v4l2src (auto-detected by 'make init')
# Detection finds the first USB video node that supports MJPG or YUYV color formats.
# Works with Intel RealSense, generic webcams, and other UVC cameras.
# Example: /dev/video36
REALSENSE_DEVICE=

# --- Live Video Captioning (docker-compose-lvc.yml) ---

# video-caption-service image, pulled from Docker Hub.
REGISTRY=intel/
TAG=latest

# Ports
WHIP_SERVER_PORT=8889
EVAM_HOST_PORT=8040
DASHBOARD_PORT=4173
METRICS_SERVICE_PORT=9090

# WebRTC defaults
WEBRTC_PEER_ID=stream

# Feature flags
ALERT_MODE=false
ENABLE_DETECTION_PIPELINE=false
CAPTION_HISTORY=3

# Optional: override the RTSP source pre-filled in the dashboard.
# Defaults to the UAV's own annotated stream (telemetry + detection overlay):
#   rtsp://dlstreamer-pipeline-server:8555/uav-mavlink-gpu
# Use the *-cpu / -npu suffix to match the device started with
# 'make start-rtsp DEVICE=cpu|gpu|npu'.
DEFAULT_RTSP_URL=

# VLM KV-cache size (memory/performance trade-off).
VLM_CACHE_SIZE=4

# Optional: NPU-specific token length controls for static-shape LLM pipelines.
NPU_MAX_PROMPT_LENGTH=1024
NPU_MIN_RESPONSE_LENGTH=128

# Model download helper ('make lvc-model' / scripts/download_lvc_models.sh)
OVMS_RELEASE_TAG=v2026.2.1
MODEL_DOWNLOAD_IMAGE_TAG=mcp-rc
HUGGINGFACEHUB_API_TOKEN=
MODEL_DOWNLOAD_EPHEMERAL_SCRIPT_URL=https://raw.githubusercontent.com/open-edge-platform/edge-ai-libraries/main/microservices/model-download/scripts/get_model.sh
# Optional: path to a local checkout of edge-ai-libraries' get_model.sh. When
# this file exists it is used instead of fetching the URL above (useful when
# raw.githubusercontent.com is unreachable through a proxy).
MODEL_DOWNLOAD_EPHEMERAL_SCRIPT_LOCAL_PATH=