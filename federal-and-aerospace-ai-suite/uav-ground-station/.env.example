#
# This file is used to set environment variables for the uav-ground-station
# viewer. Copy to .env and adjust as needed; all variables have sane defaults
# (loopback-only) if left unset.

# Local bind address/ports for this stack (defaults keep it loopback-only).
VIZ_HOST_IP=127.0.0.1
VIZ_PORT=8080

# Default value pre-filled into the dashboard's "Companion Compute IP" field
# (the UAV companion-compute board's IP/hostname) — can still be changed
# per-session in the UI.
VIZ_COMPANION_HOST=127.0.0.1

# Port numbers the UAV host publishes via its nginx reverse proxy
# (see uav-vision-analytics/configs/nginx/nginx-pymavlink.conf). Only change
# these if the remote UAV stack's nginx is configured differently.
VIZ_REMOTE_HTTPS_PORT=443
VIZ_REMOTE_MQTT_PORT=1883

# Raw RTSP port the UAV host's DL Streamer Pipeline Server publishes
# directly (not via nginx) -- see uav-vision-analytics's docker-compose
# RTSP_PORT/8555. Only used for "H.264 Relay" mode (docker-compose-mediamtx
# .yml); irrelevant for "WebRTC - Direct".
VIZ_REMOTE_RTSP_PORT=8555

# --- "H.264 Relay" mode (optional; docker-compose-mediamtx.yml) -----------
# Only needed if the remote UAV host's pipelines run with --h264 but
# WITHOUT --caption (no native WebRTC destination there). Bring up with:
#   docker compose -f docker-compose.yml -f docker-compose-mediamtx.yml up -d
#   (or: make up-relay)
#
# Local bind port for the mediamtx sidecar's WebRTC (WHEP) + ICE/UDP
# listeners (uses VIZ_HOST_IP above for the bind address, same as viz-backend).
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_WEBRTC_ICE_UDP_PORT=8189

# Public/reachable IP of THIS ground-station machine, advertised to browsers
# as a WebRTC ICE candidate host (mediamtx's MTX_WEBRTCADDITIONALHOSTS).
# Required when VIZ_HOST_IP is a bind-all address (0.0.0.0) rather than a
# single reachable IP, since mediamtx cannot advertise 0.0.0.0 as a usable
# candidate -- set this to the IP/hostname browsers actually reach this
# dashboard on.
VIZ_PUBLIC_HOST=127.0.0.1

# --- "UAV Ground Station Utilization" panel (gs-metrics-manager) ----------
# This machine's own CPU/RAM/GPU/NPU device paths, passed through to the
# gs-metrics-manager container (same intel/metrics-manager image/metric set
# the remote uav-vision-analytics host uses, named "gs-metrics-manager" so
# the two can coexist if ever run on the same machine). Auto-detected by
# 'make init', same as uav-vision-analytics's GPU_DEVICE/GPU_RENDER_DEVICE/
# NPU_DEVICE. Leave as /dev/null if the corresponding hardware isn't present
# -- gs-metrics-manager simply won't report that device's utilization.
GPU_DEVICE=/dev/null
GPU_RENDER_DEVICE=/dev/null
NPU_DEVICE=/dev/null


